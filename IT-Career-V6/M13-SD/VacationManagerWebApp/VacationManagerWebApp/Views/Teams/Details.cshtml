@model DetailsTeamViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>
<div>
    <a asp-action="AddTeamLead" asp-route-id="@Model.Id">Add team lead</a>
    <a asp-action="AddProject" asp-route-id="@Model?.Id">Add project</a>
    <a asp-action="AddDeveloper" asp-route-id="@Model?.Id">Add developer</a>
</div>
<div>
    <h4>Team</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TeamLead)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.TeamLead)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Project)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Project)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
