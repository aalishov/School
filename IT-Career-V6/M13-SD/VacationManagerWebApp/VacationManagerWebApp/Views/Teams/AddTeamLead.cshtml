@model AddTeamLeadViewModel

<h2>Edit user</h2>

<div class="row">
    <div class="col-md-4">    </div>
    <div class="col-md-4">
        <form asp-controller="Teams" asp-action="AddTeamLead" method="post">
            <h2>Add team lead</h2>
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <input type="hidden" asp-for="TeamId" />
            <div class="form-group">
                <label asp-for="TeamLeadId"></label>
                <select asp-for="TeamLeadId" class="form-control" asp-items="Model.TeamLeads"></select>
                <span asp-validation-for="TeamLeadId" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary">Add</button>
        </form>
    </div>
</div>